{
  "name": "stellar",
  "version": "1.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlon/stellar.git"
  },
  "bugs": {
    "url": "https://github.com/jlon/stellar/issues"
  },
  "scripts": {
    "ng": "ng",
    "conventional-changelog": "conventional-changelog",
    "start": "ng serve --host 0.0.0.0 --disable-host-check",
    "build": "ng build",
    "build:prod": "npm run build -- --configuration production --aot",
    "test": "ng test",
    "test:coverage": "rimraf coverage && npm run test -- --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint stellar --fix",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:ci": "npm run lint && npm run lint:styles",
    "pree2e": "webdriver-manager update --standalone false --gecko false",
    "e2e": "ng e2e",
    "docs": "compodoc -p src/tsconfig.app.json -d docs",
    "docs:serve": "compodoc -p src/tsconfig.app.json -d docs -s",
    "prepush": "npm run lint:ci",
    "release:changelog": "npm run conventional-changelog -- -p angular -i CHANGELOG.md -s"
  },
  "dependencies": {
    "@angular/animations": "21.0.6",
    "@angular/cdk": "21.0.6",
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/core": "21.0.6",
    "@angular/forms": "21.0.6",
    "@angular/platform-browser": "21.0.6",
    "@angular/platform-browser-dynamic": "21.0.6",
    "@angular/router": "21.0.6",
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "@nebular/eva-icons": "17.0.0",
    "@nebular/security": "17.0.0",
    "@nebular/theme": "17.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@types/dagre": "^0.7.53",
    "angular2-smart-table": "4.1.1",
    "bootstrap": "4.3.1",
    "clipboard": "^2.0.11",
    "core-js": "3.39.0",
    "countup.js": "^2.9.0",
    "dagre": "^0.8.5",
    "echarts": "^5.6.0",
    "eva-icons": "^1.1.3",
    "github-markdown-css": "^5.9.0",
    "html2canvas": "^1.4.1",
    "lodash-es": "^4.17.21",
    "marked": "^17.0.6",
    "nebular-icons": "1.1.0",
    "ngx-echarts": "21.0.0",
    "ngx-markdown": "^21.3.0",
    "prismjs": "^1.30.0",
    "rxjs": "7.8.2",
    "sql-formatter": "^15.6.10",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.0.6",
    "@angular-eslint/builder": "21.0.1",
    "@angular-eslint/eslint-plugin": "21.0.1",
    "@angular-eslint/eslint-plugin-template": "21.0.1",
    "@angular-eslint/schematics": "21.0.1",
    "@angular-eslint/template-parser": "21.0.1",
    "@angular/cli": "21.0.6",
    "@angular/compiler-cli": "21.0.6",
    "@angular/language-service": "21.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "fast-check": "^4.9.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "postcss-scss": "^4.0.9",
    "puppeteer": "^25.10.0",
    "rimraf": "2.6.1",
    "sass": "^1.93.2",
    "stylelint": "^14.16.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
