# Git
.git
.gitignore
.gitattributes

# Build artifacts (preserve the frontend release-build script used by Docker)
build/*
!build/build-frontend.sh
target/
backend/target/
backend/data/
backend/logs/
frontend/dist/
frontend/node_modules/
frontend/.angular/

# Development
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
docs/
README.md
LICENSE

# CI/CD
.github/
.gitlab-ci.yml

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Testing (exclude test files but keep necessary source files)
# Note: Don't use broad patterns like **/*test* as it excludes valid source files
backend/tests/**/*test*.rs
frontend/**/*spec*.ts
frontend/e2e/

# Scripts (except those needed for build)
scripts/

# Deployment assets are excluded except the image entrypoint copied by Dockerfile.
deploy/*
!deploy/docker/
deploy/docker/*
!deploy/docker/entrypoint.sh

# Temporary files
tmp/
temp/
*.tmp

